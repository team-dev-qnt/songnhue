# Chuẩn hóa line ending: repo luôn LF, tránh diff giả giữa macOS/Windows
* text=auto eol=lf

*.java   text diff=java
*.sql    text
*.yml    text
*.yaml   text
*.json   text
*.xml    text
*.md     text diff=markdown
*.ts     text
*.tsx    text
*.sh     text eol=lf
Makefile text eol=lf

# Maven wrapper: script phải LF, jar là binary
mvnw                            text eol=lf
mvnw.cmd                        text eol=crlf
.mvn/wrapper/maven-wrapper.jar  binary

# Binary — không diff, không đổi eol
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.jar  binary
*.woff binary
*.woff2 binary
*.docx binary
*.xlsx binary

# Không tính vào thống kê ngôn ngữ của GitHub
.claude/**  linguist-documentation
docs/**     linguist-documentation
