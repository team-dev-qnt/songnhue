<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.songnhue</groupId>
        <artifactId>songnhue-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>songnhue-core</artifactId>
    <name>Songnhue Core</name>
    <description>Nhóm A — Common Platform: envelope, exception, error code, filter chain, utils,
        auth/RBAC, org_units, attachment, workflow engine, notification, jobs, audit, settings.
        Mọi module nghiệp vụ bắt buộc dùng, cấm tự chế bản riêng (conventions.md §2).</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- BaseEntity/ScopedEntity + JPA auditing (T4.7) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!--
          Cache in-process thay cho Redis ở v1 (architecture-review.md §3).
          Dùng cho rate limit và cache bảng `settings`.
        -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!-- Sinh tài liệu OpenAPI cho /api/v1/** (T4.10) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
    </dependencies>
</project>
