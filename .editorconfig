root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Java — 4 space, khớp Palantir Java Format (Spotless)
[*.java]
indent_size = 4
max_line_length = 120

[*.{xml,xsd}]
indent_size = 4

# YAML bắt buộc 2 space
[*.{yml,yaml}]
indent_size = 2

[*.{json,json5}]
indent_size = 2

# Frontend — khớp Prettier
[*.{js,jsx,ts,tsx,mjs,cjs,css,scss,html}]
indent_size = 2

[*.sql]
indent_size = 4

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

# Maven wrapper — không đụng vào
[.mvn/wrapper/**]
insert_final_newline = false
trim_trailing_whitespace = false

[mvnw]
indent_style = space
indent_size = 4
