# =============================================================================
# MÔI TRƯỜNG PRODUCTION — VM-1 (architecture-review.md §9.2)
#
# Đặt tại /opt/songnhue/.env trên VM, chmod 600, chủ sở hữu root.
# Bí mật cấp qua GitHub Secrets khi deploy — KHÔNG commit giá trị thật.
#
# ⚠ Backup: RPO ≤ 24h, RTO ≤ 4h — `pg_dump` hàng đêm, KHÔNG PITR/replica.
#   Chấp nhận mất tối đa 1 ngày dữ liệu (architecture-review.md §6.5).
#
# Chú thích:  [B] bắt buộc   ·   [T] tùy chọn, có default
# =============================================================================

# --- Ứng dụng -----------------------------------------------------------------
APP_PORT=8080                       # [T]
SPRING_PROFILES_ACTIVE=prod         # [B]
LOG_LEVEL_APP=INFO                  # [T] ⛔ không để DEBUG ở production
SHEDLOCK_ENABLED=false              # [T] v1 chạy 1 node; bật khi lên ≥2 node (§6.4)
WORKER_ENABLED=true                 # [T]
APP_BASE_URL=https://songnhue.example.vn # [B]

# --- PostgreSQL ---------------------------------------------------------------
DB_HOST=postgres                    # [B]
DB_PORT=5432                        # [B]
DB_NAME=songnhue                    # [B]
DB_USER=songnhue_app                # [B]
# [B] ⛔
DB_PASSWORD=
DB_MIGRATION_USER=songnhue_owner    # [B]
# [B] ⛔
DB_MIGRATION_PASSWORD=
# [B] ⛔ job kết xuất audit — role duy nhất có DELETE audit_logs
DB_ARCHIVER_PASSWORD=
# [B] ⛔ chỉ đọc
DB_READONLY_PASSWORD=
# [B] ⛔ superuser, chỉ dùng lúc khởi tạo volume
POSTGRES_PASSWORD=

# ⚠ PHẢI là false: migration chạy ở service `migrator` riêng TRƯỚC app
# (architecture-review.md §9.2). Để true thì migration hỏng sẽ làm app lên nửa vời.
FLYWAY_ENABLED=false                # [B]
DB_POOL_MAX=20                      # [T]
DB_POOL_MIN=5                       # [T]

# Chỉ dùng ở lần dựng môi trường đầu tiên để đặt mật khẩu `superadmin`,
# sau đó GỠ khỏi file env (WS-5/T5.7).
# [T] ⛔
BOOTSTRAP_ADMIN_PASSWORD=

# --- MinIO --------------------------------------------------------------------
MINIO_ENDPOINT=http://minio:9000    # [B]
# [B] ⛔
MINIO_ACCESS_KEY=
# [B] ⛔
MINIO_SECRET_KEY=
MINIO_BUCKET_MEDIA=songnhue-media   # [B]
MINIO_BUCKET_REPORT=songnhue-report # [B]
MINIO_BUCKET_AUDIT=songnhue-audit   # [B]

# --- SMTP ---------------------------------------------------------------------
# [B]
SMTP_HOST=
SMTP_PORT=587                       # [B]
# [B] ⛔
SMTP_USERNAME=
# [B] ⛔
SMTP_PASSWORD=
SMTP_FROM=no-reply@songnhue.example.vn # [B]
SMTP_STARTTLS=true                  # [B]

# --- Khóa mã hóa & ký token ---------------------------------------------------
# ⛔ Lưu ở /opt/songnhue/keys/ (chmod 600) — KHÔNG nằm trong bản backup DB.
#    Lộ backup + lộ khóa = lộ toàn bộ employee_sensitive và credential bên thứ 3.
AES_KEY_ID=v1                       # [B]
# [B] ⛔
AES_KEY_V1=
JWT_KEY_ID=v1                       # [B]
JWT_PRIVATE_KEY_PATH=/opt/songnhue/keys/jwt-private.pem # [B]
JWT_PUBLIC_KEY_PATH=/opt/songnhue/keys/jwt-public.pem   # [B]

# --- Tích hợp bên thứ 3 -------------------------------------------------------
# ⚠ Nguồn KHÔNG có API lịch sử: poller ngừng bao lâu là mất dữ liệu bấy nhiêu,
#   không backfill được. Giám sát poller ưu tiên ngang backup DB (§8.2).
HYDRO_API_BASE_URL=http://songnhue.bhh40.net # [B]
# [B] ⛔ nhớ giữ dấu ";" cuối mã số
HYDRO_API_KEY=
EXTERNAL_DOC_SYSTEM_URL=http://songnhue.bhh40.net # [T]
EXTERNAL_DOC_SYSTEM_ENABLED=false                 # [T] chờ chốt G5
# [T]
GOOGLE_MAPS_API_KEY=

# --- Sao lưu & khôi phục (WS-7) -----------------------------------------------
# ⚠ Bản WS-3 của file này mô tả mô hình ĐẨY (BACKUP_TARGET_HOST). WS-7 đã đổi
#   sang mô hình KÉO và bỏ các biến đó — lý do ở deploy/backup/pull-from-prod.sh:
#   máy chạy ứng dụng không được giữ khoá ghi vào kho sao lưu, nếu không thì ai
#   chiếm được nó cũng xoá được mọi bản sao lưu.
#
# Lịch 02:00 và số ngày giữ nay nằm trong bảng `settings` (sửa được trên UI —
# CLAUDE.md quy tắc 12), không phải ở đây: backup.schedule-enabled ·
# backup.retention-days · backup.stale-hours.

# PHẢI là volume gắn ra ngoài container, và VM-3 kéo từ đúng thư mục này.
BACKUP_DIR=/var/lib/songnhue/backup # [B]
BACKUP_TIMEOUT=2h                   # [T]

# Khôi phục qua giao diện (M5.11) — cần quyền chủ sở hữu, nên là tính năng bật
# riêng. Để TRỐNG là lựa chọn hợp lệ: nút trên UI báo "chưa cấu hình" và khôi
# phục đi bằng docs/runbook/khoi-phuc-du-lieu.md.
# ⛔ Cân nhắc kỹ trước khi điền ở production: điền vào là tiến trình ứng dụng
#    giữ mật khẩu chủ sở hữu schema.
DB_RESTORE_USER=songnhue_owner      # [T]
# [T]
DB_RESTORE_PASSWORD=

# --- Nhật ký & giám sát (WS-7) ------------------------------------------------
LOG_FILE=/var/log/songnhue/app.log  # [B]
LOG_STRUCTURED_FORMAT=ecs           # [T] JSON cho bộ thu thập tập trung
LOG_MAX_HISTORY=30                  # [T] xoay vòng 30 ngày
LOG_TOTAL_SIZE_CAP=3GB              # [T] trần cứng — đĩa đầy thì pg_dump hỏng theo
APP_ENVIRONMENT=production          # [T] nhãn gắn vào mọi metric

# --- Frontend (build-time) ----------------------------------------------------
# ⛔ Để TRỐNG: nginx (T11.5) gộp giao diện và API về cùng một tên miền, nên đường
# dẫn tương đối `/api/v1` là đúng và không cần CORS. Điền địa chỉ tuyệt đối vào
# đây thì mỗi lần đổi tên miền là phải dựng lại image FE, và điền sai một ký tự
# là cả giao diện chết vì preflight bị backend trả `403 Invalid CORS request`.
VITE_API_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=
# Cái này thì phải tuyệt đối — gốc của sitemap, canonical, ảnh Open Graph.
NEXT_PUBLIC_SITE_URL=https://songnhue.example.vn

# ==============================================================================
# NGINX BIÊN + MINIO CHỦ + REVALIDATE — 6 biến compose ĐÒI mà mẫu cũ không có
#
# ⚠⚠ Bổ sung 24/8. `compose.prod.yml` tham chiếu cả 6 biến dưới đây ở dạng
#    `${TÊN}` KHÔNG có `:?`, nên thiếu là **giải ra chuỗi rỗng, không báo lỗi**
#    — nginx nhận `server_name` rỗng, MinIO chạy bằng tài khoản mặc định,
#    `/api/revalidate` trả 503. `ComposeEnvCompletenessTest` nay canh cho việc này.
# ==============================================================================

# --- Tên miền mà nginx biên phục vụ (không có scheme, không có dấu / cuối) ---
PUBLIC_DOMAIN=songnhue.example.vn
ADMIN_DOMAIN=admin.songnhue.example.vn
# ⚠ FILES_DOMAIN vừa là tên miền công khai của MinIO, vừa là BÍ DANH MẠNG của
#   nginx trong compose. Chữ ký presigned ký cả tên máy, nên đổi tên này mà
#   không dựng lại là mọi nút Tải về hỏng.
FILES_DOMAIN=files.songnhue.example.vn

# production → `all`. Staging phải là `noindex, nofollow`.
ROBOTS_TAG=all

# --- MinIO: tài khoản CHỦ, khác hẳn MINIO_ACCESS_KEY/SECRET_KEY ứng dụng dùng ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Khoá webhook dựng lại trang của cổng công khai ---
# ⚠ PHẢI giống nhau ở service `app` và `public-web` — compose lấy cùng từ đây.
#   Lệch nhau thì `/api/revalidate` trả 401 và cổng đứng yên ở nội dung cũ,
#   không báo lỗi. Để trống thì trả 503.
REVALIDATE_SECRET=
