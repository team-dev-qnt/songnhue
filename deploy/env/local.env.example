# =============================================================================
# MÔI TRƯỜNG LOCAL (dev) — copy thành `local.env` rồi sửa giá trị
#   cp deploy/env/local.env.example deploy/env/local.env
#
# ⛔ KHÔNG commit file `.env` thật (conventions.md §1.5, đã chặn ở .gitignore).
# ⛔ Thiếu biến BẮT BUỘC → app fail-fast lúc startup, không chạy với default ngầm
#    (conventions.md §1.6).
#
# Chú thích:  [B] bắt buộc   ·   [T] tùy chọn, có default
# =============================================================================

# --- Ứng dụng -----------------------------------------------------------------
APP_PORT=8080                       # [T] cổng HTTP
SPRING_PROFILES_ACTIVE=local        # [B] local | docker | staging | prod
LOG_LEVEL_APP=DEBUG                 # [T] mức log cho package com.songnhue

# Bật khi lên ≥2 node — architecture-review.md §6.4. Local luôn false.
SHEDLOCK_ENABLED=false              # [T]
WORKER_ENABLED=true                 # [T] worker in-process (v1)

# --- PostgreSQL 16 + PostGIS --------------------------------------------------
# Local: khớp deploy/compose.infra.yml (WS-3)
DB_HOST=localhost                   # [B]
DB_PORT=5432                        # [B]
DB_NAME=songnhue                    # [B]
# Tài khoản ứng dụng — KHÔNG có quyền DELETE trên audit_logs / hydro_raw_logs
# (DB roles tách quyền, architecture-review.md §9.3)
DB_USER=songnhue_app                # [B]
DB_PASSWORD=changeme_local          # [B]
# Tài khoản chạy migration (service `migrator`), là owner của schema
DB_MIGRATION_USER=songnhue_owner    # [B]
DB_MIGRATION_PASSWORD=changeme_local # [B]

# --- MinIO (S3-compatible) ----------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000 # [B]
MINIO_ACCESS_KEY=minioadmin          # [B]
MINIO_SECRET_KEY=changeme_local      # [B]
MINIO_BUCKET_MEDIA=songnhue-media    # [B] ảnh/tài liệu CMS + công trình + hồ sơ NV
MINIO_BUCKET_REPORT=songnhue-report  # [B] file báo cáo sinh bởi async job
MINIO_BUCKET_AUDIT=songnhue-audit    # [B] kết xuất lưu trữ audit quá hạn (G7)

# --- SMTP (local dùng MailHog) ------------------------------------------------
SMTP_HOST=localhost                 # [B]
SMTP_PORT=1025                      # [B]
SMTP_USERNAME=                      # [T] MailHog không cần auth
SMTP_PASSWORD=                      # [T]
SMTP_FROM=no-reply@songnhue.local   # [B]
SMTP_STARTTLS=false                 # [T] local false, staging/prod true

# --- Khóa mã hóa & ký token ---------------------------------------------------
# ⛔ TUYỆT ĐỐI không commit giá trị thật. Trên server lưu ở /opt/songnhue/keys/,
#    KHÔNG nằm trong bản backup DB (architecture-review.md §6.5, §9.3).
#
# AES-256-GCM cho cột nhạy cảm (employee_sensitive) + credential bên thứ 3.
# Sinh khóa:  openssl rand -base64 32
AES_KEY_ID=v1                       # [B] định danh khóa, phục vụ xoay khóa
AES_KEY_V1=REPLACE_ME_BASE64_32BYTES # [B]

# JWT ký RS256, có `kid` để xoay khóa (conventions.md §4.1).
# Sinh cặp khóa:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl rsa -pubout -in jwt-private.pem -out jwt-public.pem
JWT_KEY_ID=v1                            # [B]
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem # [B]
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem   # [B]

# --- Tích hợp bên thứ 3 -------------------------------------------------------
# API thủy văn bhh40.net (MOD-03).
# ⚠ Dấu ";" ở CUỐI mã số là BẮT BUỘC — thiếu thì API trả `not.working`,
#   trông y hệt lỗi sai key. Đừng để shell/CI trim mất.
HYDRO_API_BASE_URL=http://songnhue.bhh40.net # [B]
HYDRO_API_KEY=REPLACE_ME_MASO;               # [B] giữ nguyên dấu ";"

# Hệ thống văn bản điều hành (CN-01.7) — cùng host với API thủy văn.
# ⬜ Chi tiết cách đăng nhập chờ chốt G5, chưa dùng ở Phase 0.
EXTERNAL_DOC_SYSTEM_URL=http://songnhue.bhh40.net # [T]
EXTERNAL_DOC_SYSTEM_ENABLED=false                 # [T]

# Bản đồ: OSM mặc định, Google Maps tùy chọn (architecture-review.md §3)
GOOGLE_MAPS_API_KEY=                # [T] để trống = chỉ dùng OSM

# --- Frontend (build-time) ----------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1      # [B] admin-app
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1 # [B] public-web
NEXT_PUBLIC_SITE_URL=http://localhost:3000            # [B] public-web, dùng cho SEO/sitemap
