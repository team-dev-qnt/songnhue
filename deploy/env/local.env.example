# =============================================================================
# MÔI TRƯỜNG LOCAL (dev) — copy thành `local.env` rồi sửa giá trị
#   cp deploy/env/local.env.example deploy/env/local.env
#
# ⛔ KHÔNG commit file `.env` thật (conventions.md §1.5, đã chặn ở .gitignore).
# ⛔ Thiếu biến BẮT BUỘC → app fail-fast lúc startup, không chạy với default ngầm
#    (conventions.md §1.6).
#
# Chú thích:  [B] bắt buộc   ·   [T] tùy chọn, có default
# =============================================================================

# =============================================================================
# CỔNG — hai nhóm tách bạch, KHÔNG bao giờ đụng nhau
#
#   NATIVE : cổng mà tiến trình chạy thẳng trên máy dùng (mặc định của công cụ)
#   DOCKER : cổng mà container publish ra host — quy tắc THÊM SỐ "1" VÀO ĐẦU
#
#   | Dịch vụ        | Native | Docker |
#   |----------------|--------|--------|
#   | Backend        |  8080  | 18080  |
#   | admin-app      |  5173  | 15173  |
#   | public-web     |  3000  | 13000  |
#   | PostgreSQL     |  5432  | 15432  |
#   | MinIO API      |  9000  | 19000  |
#   | MinIO console  |  9001  | 19001  |
#   | SMTP (Mailpit) |  1025  | 11025  |
#   | Mailpit UI     |  8025  | 18025  |
#
# Nhờ tách dải, máy đã cài sẵn PostgreSQL/Redis/MinIO native vẫn chạy dự án
# được, và chạy song song native + Docker cùng lúc cũng không xung đột.
# Container còn bind đúng 127.0.0.1 nên trùng cổng là báo lỗi ngay, không âm
# thầm nối nhầm sang dịch vụ khác của máy.
# =============================================================================

# --- Ứng dụng -----------------------------------------------------------------
APP_PORT=8080                       # [T] cổng backend khi chạy NATIVE
SPRING_PROFILES_ACTIVE=local        # [B] local | staging | prod
LOG_LEVEL_APP=DEBUG                 # [T] mức log cho package com.songnhue

# --- Cổng Docker publish ra host ---------------------------------------------
DOCKER_APP_PORT=18080               # [T]
DOCKER_ADMIN_APP_PORT=15173         # [T]
DOCKER_PUBLIC_WEB_PORT=13000        # [T]
DOCKER_DB_PORT=15432                # [T]
DOCKER_MINIO_PORT=19000             # [T]
DOCKER_MINIO_CONSOLE_PORT=19001     # [T]
DOCKER_SMTP_PORT=11025              # [T]
DOCKER_MAILPIT_UI_PORT=18025        # [T]

# Bật khi lên ≥2 node — architecture-review.md §6.4. Local luôn false.
SHEDLOCK_ENABLED=false              # [T]
WORKER_ENABLED=true                 # [T] worker in-process (v1)

# --- PostgreSQL 16 + PostGIS --------------------------------------------------
# Local: khớp deploy/compose.infra.yml (WS-3)
DB_HOST=localhost                   # [B]
# Tiến trình chạy NATIVE nối vào PostgreSQL trong Docker qua cổng đã publish.
# (Container thì nối thẳng postgres:5432, compose tự ghi đè 2 biến này.)
DB_PORT=15432                       # [B] = DOCKER_DB_PORT
DB_NAME=songnhue                    # [B]
# Tài khoản ứng dụng — KHÔNG có quyền DELETE trên audit_logs / hydro_raw_logs
# (DB roles tách quyền, architecture-review.md §9.3)
DB_USER=songnhue_app                # [B]
DB_PASSWORD=changeme_local          # [B]
# Tài khoản chạy migration (service `migrator`), là owner của schema
DB_MIGRATION_USER=songnhue_owner    # [B]
DB_MIGRATION_PASSWORD=changeme_local # [B]
# Job kết xuất audit quá hạn (G7) — role DUY NHẤT có DELETE trên audit_logs
DB_ARCHIVER_PASSWORD=changeme_local # [B]
# Chỉ đọc — báo cáo ad-hoc, điều tra sự cố, VÀ chạy pg_dump (WS-7).
# Sao lưu chỉ cần ĐỌC: cấp quyền ghi cho việc chạy mỗi đêm là mở rộng vô cớ
# phạm vi thiệt hại khi tiến trình ứng dụng bị chiếm quyền.
DB_READONLY_USER=songnhue_readonly  # [T]
DB_READONLY_PASSWORD=changeme_local # [B]
# Superuser của container Postgres (chỉ dùng lúc khởi tạo, xem
# deploy/postgres/init/10-bootstrap.sh)
POSTGRES_PASSWORD=changeme_local    # [B]

# Local chạy migration ngay trong app cho tiện; Staging/Prod đặt false vì
# migration chạy ở service `migrator` riêng (architecture-review.md §9.2)
FLYWAY_ENABLED=true                 # [T]
DB_POOL_MAX=20                      # [T]
DB_POOL_MIN=5                       # [T]

# Đặt mật khẩu cho tài khoản `superadmin` ở lần dựng môi trường ĐẦU TIÊN.
# Migration seed tài khoản này ở trạng thái PENDING_ACTIVATION, chưa đăng nhập
# được (không có mật khẩu mặc định trong repo). Chạy xong thì GỠ biến này.
# [T] chỉ dùng 1 lần — WS-5/T5.7
BOOTSTRAP_ADMIN_PASSWORD=

# --- Sao lưu & khôi phục (WS-7) -----------------------------------------------
# Thư mục chứa bản dump. Trên máy chủ PHẢI là volume gắn ra ngoài container —
# để trong container thì bản sao lưu biến mất cùng lần deploy kế tiếp.
BACKUP_DIR=./.backup                # [B] local: thư mục trong repo, đã .gitignore
BACKUP_TIMEOUT=2h                   # [T] hạn cho một lượt dump/restore

# ⚠ KHÔI PHỤC QUA GIAO DIỆN LÀ TÍNH NĂNG BẬT RIÊNG.
# Để TRỐNG thì nút khôi phục (M5.11) báo "chưa cấu hình" (ADM-2010) và từ chối
# ngay, thay vì chạy nửa chừng rồi hỏng ở lệnh DROP. Khôi phục cần quyền chủ sở
# hữu; nơi nào không muốn giữ mật khẩu đó trong tiến trình ứng dụng thì cứ để
# trống và khôi phục bằng docs/runbook/khoi-phuc-du-lieu.md — đó là lựa chọn
# hợp lệ, không phải thiếu sót.
DB_RESTORE_USER=songnhue_owner      # [T]
# [T] để trống = tắt khôi phục qua UI
DB_RESTORE_PASSWORD=

# --- Nhật ký & giám sát (WS-7) ------------------------------------------------
# Để trống = chỉ log ra console (đúng cho local). Đặt đường dẫn thì bật xoay
# vòng theo ngày, giữ 30 ngày, có trần tổng dung lượng.
# [T]
LOG_FILE=
LOG_MAX_HISTORY=30                  # [T]
LOG_TOTAL_SIZE_CAP=3GB              # [T]
# Nhãn `environment` gắn vào mọi metric — Prometheus trên VM-3 gom số của nhiều
# môi trường vào một chỗ, thiếu nhãn này thì staging và production lẫn nhau.
APP_ENVIRONMENT=local               # [T]

# --- MinIO (S3-compatible) ----------------------------------------------------
MINIO_ENDPOINT=http://localhost:19000 # [B] = DOCKER_MINIO_PORT (cho tiến trình native)
MINIO_ACCESS_KEY=minioadmin          # [B]
MINIO_SECRET_KEY=changeme_local      # [B]
MINIO_BUCKET_MEDIA=songnhue-media    # [B] ảnh/tài liệu CMS + công trình + hồ sơ NV
MINIO_BUCKET_REPORT=songnhue-report  # [B] file báo cáo sinh bởi async job
MINIO_BUCKET_AUDIT=songnhue-audit    # [B] kết xuất lưu trữ audit quá hạn (G7)

# --- SMTP (local dùng Mailpit — xem thư ở http://localhost:18025) -------------
SMTP_HOST=localhost                 # [B]
SMTP_PORT=11025                     # [B] = DOCKER_SMTP_PORT (cho tiến trình native)
# [T] Mailpit không cần auth
SMTP_USERNAME=
# [T]
SMTP_PASSWORD=
SMTP_FROM=no-reply@songnhue.local   # [B]
SMTP_STARTTLS=false                 # [T] local false, staging/prod true

# --- Khóa mã hóa & ký token ---------------------------------------------------
# ⛔ TUYỆT ĐỐI không commit giá trị thật. Trên server lưu ở /opt/songnhue/keys/,
#    KHÔNG nằm trong bản backup DB (architecture-review.md §6.5, §9.3).
#
# AES-256-GCM cho cột nhạy cảm (employee_sensitive) + credential bên thứ 3.
# Sinh khóa:  openssl rand -base64 32
AES_KEY_ID=v1                       # [B] định danh khóa, phục vụ xoay khóa
AES_KEY_V1=REPLACE_ME_BASE64_32BYTES # [B]

# JWT ký RS256, có `kid` để xoay khóa (conventions.md §4.1).
# Sinh cặp khóa:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl rsa -pubout -in jwt-private.pem -out jwt-public.pem
JWT_KEY_ID=v1                            # [B]
# Local chạy http:// → PHẢI để false. Bật lên thì trình duyệt bỏ luôn cookie
# refresh và CSRF, kết quả là đăng nhập xong vẫn không vào được, mà không có
# thông báo lỗi nào. Staging/Production chạy HTTPS nên để true.
SECURE_COOKIE=false                      # [T]
# Đường dẫn cho tiến trình NATIVE (chạy từ thư mục backend/).
# Container thì compose ghi đè sang /app/keys/ và mount deploy/keys vào đó.
JWT_PRIVATE_KEY_PATH=../deploy/keys/jwt-private.pem # [B]
JWT_PUBLIC_KEY_PATH=../deploy/keys/jwt-public.pem   # [B]

# --- Tích hợp bên thứ 3 -------------------------------------------------------
# API thủy văn bhh40.net (MOD-03).
# ⚠ Dấu ";" ở CUỐI mã số là BẮT BUỘC — thiếu thì API trả `not.working`,
#   trông y hệt lỗi sai key. Đừng để shell/CI trim mất.
HYDRO_API_BASE_URL=http://songnhue.bhh40.net # [B]
HYDRO_API_KEY=REPLACE_ME_MASO;               # [B] giữ nguyên dấu ";"

# Hệ thống văn bản điều hành (CN-01.7) — cùng host với API thủy văn.
# ⬜ Chi tiết cách đăng nhập chờ chốt G5, chưa dùng ở Phase 0.
EXTERNAL_DOC_SYSTEM_URL=http://songnhue.bhh40.net # [T]
EXTERNAL_DOC_SYSTEM_ENABLED=false                 # [T]

# Bản đồ: OSM mặc định, Google Maps tùy chọn (architecture-review.md §3)
# [T] để trống = chỉ dùng OSM
GOOGLE_MAPS_API_KEY=

# --- Frontend (build-time) ----------------------------------------------------
# ⛔⛔ HAI BIẾN DƯỚI PHẢI ĐỂ TRỐNG. Điền địa chỉ tuyệt đối vào là hỏng cả giao diện.
#
# Trình duyệt luôn gọi API ở CÙNG origin với trang; tầng phục vụ lo chuyển tiếp
# (nginx của image admin-app · Route Handler của public-web · `server.proxy` của
# Vite khi chạy native). Để trống thì mã FE rơi về đường dẫn tương đối `/api/v1`.
#
# Bản trước điền `http://localhost:18080/api/v1`: trình duyệt ở cổng 15173 gọi
# sang cổng 18080 là KHÁC ORIGIN, mà backend không cấu hình CORS → preflight trả
# `403 Invalid CORS request` → không một lượt gọi nào chạy được, bắt đầu từ ô
# đăng nhập.
#
# ⚠⚠ Và tệp này là nơi QUYẾT ĐỊNH, không phải `compose.local.yml`. Makefile chạy
# compose với `--env-file`, mà `--env-file` nuôi luôn phép thế biến — nên
# `${VITE_API_BASE_URL:-}` trong compose CHỈ có tác dụng khi biến vắng mặt ở đây.
# Sửa mặc định bên compose mà để nguyên dòng này là sửa vào chỗ không ai đọc.
VITE_API_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=
# Cái này thì ngược lại — phải là địa chỉ tuyệt đối, vì nó là gốc của sitemap,
# thẻ canonical và ảnh Open Graph, tức là địa chỉ người ngoài mở được.
NEXT_PUBLIC_SITE_URL=http://localhost:13000            # [B] public-web, dùng cho SEO/sitemap

# Đích mà nginx của admin-app chuyển tiếp `/api` tới. Đọc LÚC CHẠY (không phải
# lúc build) nên đổi không cần dựng lại image.
#   backend DOCKER (make dev-docker) → http://app:8080          ← mặc định
#   backend NATIVE (make dev-fe)     → http://host.docker.internal:8080
API_UPSTREAM=http://app:8080
