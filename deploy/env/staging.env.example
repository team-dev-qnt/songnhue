# =============================================================================
# MÔI TRƯỜNG STAGING — VM-2 (architecture-review.md §9.2)
#
# Đặt tại /opt/songnhue/.env trên VM, chmod 600, chủ sở hữu root.
# Bí mật cấp qua GitHub Secrets khi deploy — KHÔNG commit giá trị thật.
# VM-2 còn là ĐÍCH DIỄN TẬP RESTORE định kỳ (T7.7).
#
# Chú thích:  [B] bắt buộc   ·   [T] tùy chọn, có default
# =============================================================================

# --- Ứng dụng -----------------------------------------------------------------
APP_PORT=8080                       # [T]
SPRING_PROFILES_ACTIVE=staging      # [B]
LOG_LEVEL_APP=INFO                  # [T]
SHEDLOCK_ENABLED=false              # [T] staging 1 node
WORKER_ENABLED=true                 # [T]
APP_BASE_URL=https://staging.songnhue.example.vn # [B] dùng trong email/link báo cáo

# --- PostgreSQL ---------------------------------------------------------------
DB_HOST=postgres                    # [B] tên service trong compose
DB_PORT=5432                        # [B]
DB_NAME=songnhue                    # [B]
DB_USER=songnhue_app                # [B]
# [B] ⛔ từ GitHub Secrets
DB_PASSWORD=
DB_MIGRATION_USER=songnhue_owner    # [B]
# [B] ⛔ từ GitHub Secrets
DB_MIGRATION_PASSWORD=
# [B] ⛔ job kết xuất audit — role duy nhất có DELETE audit_logs
DB_ARCHIVER_PASSWORD=
# [B] ⛔ chỉ đọc
DB_READONLY_PASSWORD=
# [B] ⛔ superuser, chỉ dùng lúc khởi tạo volume
POSTGRES_PASSWORD=

# ⚠ PHẢI là false: migration chạy ở service `migrator` riêng TRƯỚC app
# (architecture-review.md §9.2). Để true thì migration hỏng sẽ làm app lên nửa vời.
FLYWAY_ENABLED=false                # [B]
DB_POOL_MAX=20                      # [T]
DB_POOL_MIN=5                       # [T]

# Chỉ dùng ở lần dựng môi trường đầu tiên để đặt mật khẩu `superadmin`,
# sau đó GỠ khỏi file env (WS-5/T5.7).
# [T] ⛔
BOOTSTRAP_ADMIN_PASSWORD=

# --- MinIO --------------------------------------------------------------------
MINIO_ENDPOINT=http://minio:9000    # [B]
# [B] ⛔
MINIO_ACCESS_KEY=
# [B] ⛔
MINIO_SECRET_KEY=
MINIO_BUCKET_MEDIA=songnhue-media   # [B]
MINIO_BUCKET_REPORT=songnhue-report # [B]
MINIO_BUCKET_AUDIT=songnhue-audit   # [B]

# --- Nội dung seed cho cổng (CHỈ staging) -------------------------------------
# ⭐ MỘT công tắc, hai vế — và hai vế đọc CÙNG một biến.
#
#   • `migrator`   → Flyway giải thêm migration seed (5 bài + 4 hàng đính kèm, và
#                    nó XOÁ mọi bài không có mục menu trỏ tới).
#   • `minio-init` → đẩy byte của 4 ảnh lên bucket media, từ `/seed-media` (đường
#                    dẫn do bind mount trong compose ghim, không phải biến).
#
#   Trước đây vế thứ hai có biến riêng, và bật lệch là hỏng CÂM: có hàng mà không
#   có byte thì CSDL vẫn nói tệp tồn tại còn `GET /api/v1/public/files/<id>` trả
#   404; có byte mà không có hàng thì 4 tệp nằm không ai đọc. Nay lệch là điều
#   không biểu diễn được (T11.26).
#
# ⛔ Tệp mẫu của production để TRỐNG — xem `prod.env.example`.
SEED_LOCATION=classpath:db/seed/portal   # [B]

# --- SMTP ---------------------------------------------------------------------
# [B]
SMTP_HOST=
SMTP_PORT=587                       # [B]
# [B] ⛔
SMTP_USERNAME=
# [B] ⛔
SMTP_PASSWORD=
SMTP_FROM=no-reply@songnhue.example.vn # [B]
SMTP_STARTTLS=true                  # [B]

# --- Khóa mã hóa & ký token ---------------------------------------------------
# ⛔ Lưu ở /opt/songnhue/keys/ — KHÔNG nằm trong bản backup DB (§6.5).
AES_KEY_ID=v1                       # [B]
# [B] ⛔
AES_KEY_V1=
JWT_KEY_ID=v1                       # [B]
JWT_PRIVATE_KEY_PATH=/opt/songnhue/keys/jwt-private.pem # [B]
JWT_PUBLIC_KEY_PATH=/opt/songnhue/keys/jwt-public.pem   # [B]

# --- Tích hợp bên thứ 3 -------------------------------------------------------
HYDRO_API_BASE_URL=http://songnhue.bhh40.net # [B]
# [B] ⛔ nhớ giữ dấu ";" cuối mã số
HYDRO_API_KEY=
EXTERNAL_DOC_SYSTEM_URL=http://songnhue.bhh40.net # [T]
EXTERNAL_DOC_SYSTEM_ENABLED=false                 # [T] chờ chốt G5
# [T]
GOOGLE_MAPS_API_KEY=

# --- Sao lưu & khôi phục (WS-7) -----------------------------------------------
# ⚠ Bản WS-3 mô tả mô hình ĐẨY (BACKUP_TARGET_HOST); WS-7 đổi sang mô hình KÉO
#   và bỏ các biến đó — xem deploy/backup/pull-from-prod.sh.
# Lịch và retention nay nằm trong bảng `settings`, sửa được trên UI.
BACKUP_DIR=/var/lib/songnhue/backup # [B]
BACKUP_TIMEOUT=2h                   # [T]

# Staging là nơi DIỄN TẬP khôi phục (T7.7) và là nơi §7.3 khuyến nghị khôi phục
# ra để đối chiếu trước khi động vào production → ở đây thì NÊN bật.
DB_RESTORE_USER=songnhue_owner      # [T]
# [T] điền để bật khôi phục qua UI
DB_RESTORE_PASSWORD=

# --- Nhật ký & giám sát (WS-7) ------------------------------------------------
LOG_FILE=/var/log/songnhue/app.log  # [B]
LOG_STRUCTURED_FORMAT=ecs           # [T]
LOG_MAX_HISTORY=30                  # [T]
APP_ENVIRONMENT=staging             # [T] nhãn gắn vào mọi metric

# --- Frontend (build-time) ----------------------------------------------------
# ⛔ Để TRỐNG: nginx (T11.5) gộp giao diện và API về cùng một tên miền, nên đường
# dẫn tương đối `/api/v1` là đúng và không cần CORS. Điền địa chỉ tuyệt đối vào
# đây thì mỗi lần đổi tên miền là phải dựng lại image FE, và điền sai một ký tự
# là cả giao diện chết vì preflight bị backend trả `403 Invalid CORS request`.
VITE_API_BASE_URL=
NEXT_PUBLIC_API_BASE_URL=
# Cái này thì phải tuyệt đối — gốc của sitemap, canonical, ảnh Open Graph.
NEXT_PUBLIC_SITE_URL=https://staging.songnhue.example.vn

# ==============================================================================
# NGINX BIÊN + MINIO CHỦ + REVALIDATE — 6 biến compose ĐÒI mà mẫu cũ không có
#
# ⚠⚠ Vì sao khối này phải tồn tại (bổ sung 24/8): `compose.prod.yml` tham chiếu
#    cả 6 biến dưới đây, nhưng cả hai tệp mẫu đều thiếu chúng. Và chúng viết ở
#    dạng `${TÊN}` KHÔNG có `:?`, nên thiếu là **giải ra chuỗi rỗng, không báo
#    lỗi** — nginx nhận `server_name` rỗng, MinIO chạy bằng tài khoản mặc định,
#    `/api/revalidate` trả 503. Không dòng nào nói ra điều đó.
#    `ComposeEnvCompletenessTest` nay canh cho việc này.
# ==============================================================================

# --- Tên miền mà nginx biên phục vụ (không có scheme, không có dấu / cuối) ---
PUBLIC_DOMAIN=staging.songnhue.example.vn
ADMIN_DOMAIN=admin-staging.songnhue.example.vn
# ⚠ FILES_DOMAIN vừa là tên miền công khai của MinIO, vừa là BÍ DANH MẠNG của
#   nginx trong compose. Chữ ký presigned ký cả tên máy, nên đổi tên này mà
#   không dựng lại là mọi nút Tải về hỏng.
FILES_DOMAIN=files-staging.songnhue.example.vn

# ⛔⛔ STAGING PHẢI LÀ `noindex, nofollow`. Compose để mặc định là `all`, nghĩa
#     là QUÊN DÒNG NÀY THÌ GOOGLE ĐÁNH CHỈ MỤC STAGING — và vì hai môi trường
#     chạy cùng image, sitemap của staging còn mang địa chỉ production.
ROBOTS_TAG=noindex, nofollow

# --- MinIO: tài khoản CHỦ, khác hẳn MINIO_ACCESS_KEY/SECRET_KEY ứng dụng dùng ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Khoá webhook dựng lại trang của cổng công khai ---
# ⚠ PHẢI giống nhau ở service `app` và `public-web` — compose lấy cùng từ đây.
#   Lệch nhau thì `/api/revalidate` trả 401 và cổng đứng yên ở nội dung cũ,
#   không báo lỗi. Để trống thì trả 503.
REVALIDATE_SECRET=

# ==============================================================================
# GIÁM SÁT — chỉ VPS-2. Prometheus + Grafana + node-exporter chạy ở đây để còn
# sống khi VPS-1 chết (compose.observability.yml).
#
# ⚠ Bổ sung 24/8. `GRAFANA_ADMIN_PASSWORD` viết ở dạng `${…:?}` nên THIẾU LÀ
#   DỪNG NGAY: `docker compose -f compose.observability.yml up -d` thoát với
#   "Thiếu GRAFANA_ADMIN_PASSWORD" trước khi container nào lên. Biến này trước
#   đây không có trong tệp mẫu nào, cũng không nằm trong deploy-guideline.md.
#
# ⚠ Cả Prometheus lẫn Grafana đều publish ra 127.0.0.1, KHÔNG ra 0.0.0.0 — vào
#   xem bằng SSH tunnel, không mở cổng tường lửa:
#     ssh -N -L 13001:127.0.0.1:13001 songnhue@<VPS-2>
# ==============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
OBS_PROMETHEUS_PORT=19090
OBS_GRAFANA_PORT=13001
OBS_TEXTFILE_DIR=/var/lib/node_exporter/textfile
