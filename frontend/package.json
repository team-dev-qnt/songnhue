{
  "name": "songnhue-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend workspace — admin-app (Vite/React/AntD) + public-web (Next.js/Tailwind)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "design-tokens",
    "admin-app",
    "public-web"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "seed:portal": "npx tsx ../tools/seeder/seed-portal-data.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
